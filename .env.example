# Optional language and image generation. Keep real values on the server only.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1

# Optional read-only Admin API connection for a store in your Shopify organization.
# Create a Shopify app with read_products scope; keep client secret server-side.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# Client-credentials grant. Leave blank to use demo mode.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Optional local settings
DATABASE_PATH=./studio.db
HOST=127.0.0.1
PORT=5000
# FLASK_DEBUG=0
