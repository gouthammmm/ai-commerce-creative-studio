<section class="campaign-countdown" data-end="{{ section.settings.end_date | escape }}"><p>{{ section.settings.kicker | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><div class="countdown-readout" aria-live="polite">Campaign dates set in theme editor</div>{% if section.settings.link != blank %}<a href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}</a>{% endif %}</section>
{% schema %}{"name":"Campaign countdown","settings":[{"type":"text","id":"kicker","label":"Eyebrow","default":"The seasonal edit"},{"type":"text","id":"heading","label":"Heading","default":"A little time for living."},{"type":"text","id":"end_date","label":"End date · ISO with timezone","default":"2026-12-01T00:00:00+04:00"},{"type":"url","id":"link","label":"Link"},{"type":"text","id":"link_label","label":"Link label","default":"Explore the collection"}],"presets":[{"name":"Campaign countdown"}]}{% endschema %}
