<section class="page-width cart-page"><p class="eyebrow">YOUR AURA BAG</p><h1>Pieces to come home to.</h1>{% if cart.item_count > 0 %}<form action="{{ routes.cart_url }}" method="post"><div class="cart-lines">{% for item in cart.items %}<article class="cart-line"><a href="{{ item.url }}">{{ item.image | image_url: width: 320 | image_tag: loading: 'lazy', alt: item.image.alt }}</a><div><a href="{{ item.url }}">{{ item.product.title | escape }}</a><p>{{ item.variant.title | escape }}</p><label for="Quantity-{{ forloop.index }}">Quantity</label><input id="Quantity-{{ forloop.index }}" name="updates[]" type="number" min="0" value="{{ item.quantity }}"><a href="{{ item.url_to_remove }}">Remove</a></div><strong>{{ item.final_line_price | money }}</strong></article>{% endfor %}</div><p>Subtotal {{ cart.total_price | money }}</p><button class="button" name="update">Update bag</button><button class="button" name="checkout">Continue to secure Shopify checkout</button></form>{% else %}<p>Your bag is waiting for something considered.</p><a href="{{ routes.all_products_collection_url }}">Explore objects ↗</a>{% endif %}</section>
{% schema %}{"name":"Main cart","settings":[],"presets":[{"name":"Main cart"}]}{% endschema %}
