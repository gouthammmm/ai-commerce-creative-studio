<section class="promo-banner" style="--promo-bg: {{ section.settings.background }}; --promo-ink: {{ section.settings.text_color }}"><p class="eyebrow">{{ section.settings.kicker | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.body | escape }}</p>{% if section.settings.link != blank %}<a href="{{ section.settings.link }}">{{ section.settings.link_label | escape }} ↗</a>{% endif %}</section>
{% schema %}{"name":"Promotional banner","settings":[{"type":"text","id":"kicker","label":"Eyebrow","default":"A little more room to settle"},{"type":"text","id":"heading","label":"Heading","default":"A considered offer."},{"type":"textarea","id":"body","label":"Body","default":"Complimentary delivery on considered pieces over AED 500."},{"type":"url","id":"link","label":"Link"},{"type":"text","id":"link_label","label":"Link label","default":"Explore the edit"},{"type":"color","id":"background","label":"Background","default":"#e9e5db"},{"type":"color","id":"text_color","label":"Text","default":"#32342d"}],"presets":[{"name":"Promotional banner"}]}{% endschema %}
