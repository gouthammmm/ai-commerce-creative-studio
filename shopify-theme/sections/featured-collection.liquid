<section class="featured-collection page-width"><div class="section-heading"><p class="eyebrow">{{ section.settings.kicker | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div>{% assign collection = section.settings.collection %}<div class="product-grid">{% for product in collection.products limit: section.settings.limit %}{% render 'product-card', product: product %}{% else %}<p>Select a collection in the theme editor to show products.</p>{% endfor %}</div></section>
{% schema %}{"name":"Featured collection","settings":[{"type":"text","id":"kicker","label":"Eyebrow","default":"The considered edit"},{"type":"text","id":"heading","label":"Heading","default":"Objects with presence."},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"limit","label":"Products to show","min":2,"max":8,"step":1,"default":4}],"presets":[{"name":"Featured collection"}]}{% endschema %}
