<section class="product-detail page-width" data-product-form>
  <div class="product-detail__media">{% if product.featured_image %}{{ product.featured_image | image_url: width: 1600 | image_tag: widths: '600, 900, 1200, 1600', sizes: '55vw', loading: 'eager', alt: product.featured_image.alt }}{% endif %}</div>
  <div class="product-detail__copy"><p class="eyebrow">{{ product.type | default: 'AURA LIVING' | escape }}</p><h1>{{ product.title | escape }}</h1><p>{{ product.price | money }}</p><div class="rte">{{ product.description }}</div>
    {% form 'product', product, id: 'ProductForm' %}<label for="VariantSelect">Finish</label><select id="VariantSelect" name="id">{% for variant in product.variants %}<option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title | escape }} — {{ variant.price | money }}{% unless variant.available %} — Sold out{% endunless %}</option>{% endfor %}</select><label for="Quantity">Quantity</label><input id="Quantity" type="number" name="quantity" min="1" value="1"><button class="button" type="submit" {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>Add to bag</button>{% endform %}
  </div>
</section>
{% schema %}{"name":"Main product","settings":[],"presets":[{"name":"Main product"}]}{% endschema %}
