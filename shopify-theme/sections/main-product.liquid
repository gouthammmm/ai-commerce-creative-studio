<section class="product-detail page-width" data-product-form data-section-id="{{ section.id }}">
  <div class="product-detail__media">{% if product.featured_image %}{{ product.featured_image | image_url: width: 1600 | image_tag: widths: '600, 900, 1200, 1600', sizes: '(min-width: 990px) 55vw, 100vw', loading: 'eager', alt: product.featured_image.alt | default: product.title | escape, data-product-image: '' }}{% endif %}</div>
  <div class="product-detail__copy"><p class="eyebrow">{{ product.type | default: shop.name | escape }}</p><h1>{{ product.title | escape }}</h1>
    <p class="product-detail__price" aria-live="polite" data-product-price>{{ product.selected_or_first_available_variant.price | money }}{% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}<s>{{ product.selected_or_first_available_variant.compare_at_price | money }}</s>{% endif %}</p>
    <div class="rte">{{ product.description }}</div>
    {% form 'product', product, id: 'ProductForm-' | append: section.id %}
      {% unless product.has_only_default_variant %}<label for="VariantSelect-{{ section.id }}">Choose an option</label><select id="VariantSelect-{{ section.id }}" name="id" data-variant-select>{% for variant in product.variants %}<option value="{{ variant.id }}" data-price="{{ variant.price }}" data-compare="{{ variant.compare_at_price | default: 0 }}" data-available="{{ variant.available }}" data-image="{{ variant.featured_image | image_url: width: 1600 }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title | escape }}{% unless variant.available %} — Sold out{% endunless %}</option>{% endfor %}</select>{% else %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">{% endunless %}
      <label for="Quantity-{{ section.id }}">Quantity</label><input id="Quantity-{{ section.id }}" type="number" name="quantity" min="1" value="1" inputmode="numeric">
      <button class="button" type="submit" data-add-button {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>{% if product.selected_or_first_available_variant.available %}Add to bag{% else %}Sold out{% endif %}</button>
      <p class="product-detail__reassurance">Secure checkout · Delivery and returns shown at checkout</p><p role="status" aria-live="polite" data-variant-status></p>
    {% endform %}
  </div>
</section>
{% schema %}{"name":"Main product","settings":[],"presets":[{"name":"Main product"}]}{% endschema %}
