<section class="page-width search-page"><p class="eyebrow">FIND YOUR NEXT FAVORITE</p><h1>Search the collection.</h1><form action="{{ routes.search_url }}" method="get" role="search"><label for="Search-In-Template">Search objects</label><input id="Search-In-Template" type="search" name="q" value="{{ search.terms | escape }}"><input type="hidden" name="options[prefix]" value="last"><button class="button" type="submit">Search</button></form>{% if search.performed %}<p>{{ search.results_count }} results for “{{ search.terms | escape }}”</p><div class="product-grid">{% paginate search.results by 16 %}{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'product-card', product: item %}{% endif %}{% endfor %}{% if paginate.pages > 1 %}{{ paginate | default_pagination }}{% endif %}{% endpaginate %}</div>{% endif %}</section>
{% schema %}{"name":"Main search","settings":[],"presets":[{"name":"Main search"}]}{% endschema %}
