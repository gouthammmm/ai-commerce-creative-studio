<section class="recommended-products page-width"><p class="eyebrow">{{ section.settings.kicker | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><div class="product-grid">{% assign rec = section.settings.collection %}{% assign current_product = product %}{% for product in rec.products limit: section.settings.limit %}{% unless product.id == current_product.id %}{% render 'product-card', product: product %}{% endunless %}{% endfor %}</div></section>
{% schema %}{"name":"Recommended products","settings":[{"type":"text","id":"kicker","label":"Eyebrow","default":"Consider alongside"},{"type":"text","id":"heading","label":"Heading","default":"The details that bring it together."},{"type":"collection","id":"collection","label":"Fallback recommendation collection"},{"type":"range","id":"limit","label":"Products","min":2,"max":6,"step":1,"default":3}],"presets":[{"name":"Recommended products"}]}{% endschema %}
