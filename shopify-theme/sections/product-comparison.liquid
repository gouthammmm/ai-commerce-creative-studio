<section class="comparison page-width"><p class="eyebrow">{{ section.settings.kicker | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><div class="comparison-grid"><div class="comparison-label"><strong>Compare by</strong><span>Material</span><span>Dimensions</span><span>Finish</span></div>{% for product in section.settings.products %}<div class="comparison-product">{% if product.featured_image %}{{ product.featured_image | image_url: width: 420 | image_tag: loading: 'lazy', alt: product.featured_image.alt }}{% endif %}<strong>{{ product.title | escape }}</strong><span>{{ product.metafields.custom.material.value | default: 'Details on product page' | escape }}</span><span>{{ product.metafields.custom.dimensions.value | default: 'Details on product page' | escape }}</span><span>{{ product.metafields.custom.finish.value | default: 'Multiple finishes' | escape }}</span><a href="{{ product.url }}">View object ↗</a></div>{% endfor %}</div></section>
{% schema %}{"name":"Product comparison","settings":[{"type":"text","id":"kicker","label":"Eyebrow","default":"A considered comparison"},{"type":"text","id":"heading","label":"Heading","default":"Find the right form."},{"type":"product_list","id":"products","label":"Products to compare","limit":3}],"presets":[{"name":"Product comparison"}]}{% endschema %}
