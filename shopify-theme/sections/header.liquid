{% if section.settings.announcement != blank %}<div class="announcement-bar">{{ section.settings.announcement | escape }}</div>{% endif %}
<header class="site-header"><a class="wordmark" href="{{ routes.root_url }}">AURA <span>LIVING</span></a><nav aria-label="Main navigation"><a href="{{ routes.all_products_collection_url }}">Shop</a><a href="/pages/about">Our approach</a><a href="/blogs/journal">Journal</a></nav><div class="header-actions"><a href="{{ routes.search_url }}">Search</a><a href="{{ routes.cart_url }}">Bag ({{ cart.item_count }})</a></div><button class="menu-toggle" aria-expanded="false" aria-label="Open menu">Menu</button></header>
{% schema %}{"name":"Header","settings":[{"type":"text","id":"announcement","label":"Announcement","default":"Complimentary UAE delivery on orders over AED 500"}],"presets":[{"name":"Header"}]}{% endschema %}
