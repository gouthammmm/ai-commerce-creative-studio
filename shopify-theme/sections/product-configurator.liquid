<section class="product-configurator page-width"><p class="eyebrow">{{ section.settings.kicker | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.body | escape }}</p><fieldset><legend>Choose a finish</legend>{% assign current_product = section.settings.product %}{% for option in current_product.options_with_values %}{% if option.name == 'Color' or option.name == 'Finish' %}<div class="finish-options">{% for value in option.values %}<button type="button" class="finish-option" data-finish="{{ value | escape }}">{{ value | escape }}</button>{% endfor %}</div>{% endif %}{% endfor %}</fieldset><p class="configurator-note">Finish selection is a UI concept. Actual variant synchronization should use Shopify product variants or the Storefront API.</p></section>
{% schema %}{"name":"Product configurator","settings":[{"type":"text","id":"kicker","label":"Eyebrow","default":"Make it yours"},{"type":"text","id":"heading","label":"Heading","default":"Choose a finish."},{"type":"textarea","id":"body","label":"Body","default":"See how a considered finish changes the feeling of a room."},{"type":"product","id":"product","label":"Product context"}],"presets":[{"name":"Product configurator"}]}{% endschema %}
